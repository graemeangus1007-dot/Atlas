# Copy to .env.local and fill in values from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy (optional): still accepted if PUBLISHABLE_KEY is unset
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Deployment provider (server-controlled — Sprint 14.4D)
# Never put Vercel credentials in NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------
# - mock (default): local simulated deploy
# - supabase: legacy Supabase Storage site-previews host
# - vercel: real Vercel preview deployments (recommended)
DEPLOYMENT_PROVIDER=vercel

# Vercel Deployments API (required when DEPLOYMENT_PROVIDER=vercel)
VERCEL_TOKEN=
# MUST be a dedicated "Other" / no-framework project for published customer
# static sites — do NOT reuse the Atlas Next.js app project id (projectSettings
# on API deploys are saved onto the target project and would break Atlas builds).
VERCEL_PROJECT_ID=
# Optional — personal accounts can omit this
# VERCEL_TEAM_ID=

# Custom domains (Sprint 16.0B) — server-only provider selection
# - mock (default): local DNS instruction records, no Vercel Domains API
# - vercel: Vercel Domains API (addDomain / verify / SSL / remove; uses VERCEL_* above)
# DOMAIN_PROVIDER=mock
# Local mock verify outcomes: pending | fail | ssl_pending | active
# MOCK_DOMAIN_VERIFY_SCENARIO=pending

# Legacy client flag (optional fallback only; prefer DEPLOYMENT_PROVIDER)
# NEXT_PUBLIC_DEPLOYMENT_PROVIDER=mock

# Public Atlas origin for published contact forms (Sprint 17.0A / 17.0C)
# Absolute origin for POST /api/forms/:formId/submit on deployed sites.
# Prefer server-only APP_URL (required for Vercel publishes).
# Do NOT set this to http://localhost — published previews cannot reach it.
# Local next dev may use localhost for in-app APIs only; publishable HTML
# never embeds localhost.
APP_URL=https://your-atlas-app.vercel.app
# Optional client fallback (same non-localhost origin):
# NEXT_PUBLIC_APP_URL=https://your-atlas-app.vercel.app
# Required in production — salt for hashing submitter IPs (never store raw IPs)
LEAD_IP_HASH_SALT=
# Required in production — salt for hashing analytics visitor ids
ANALYTICS_VISITOR_SALT=

# Optional — when set, monitoring uses the Sentry-ready provider (requires
# a Sentry bridge on globalThis.Sentry; otherwise falls back to console)
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Stripe billing (Sprint 19.0B) — production architecture
# Never put STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → endpoint signing secret
# Endpoint URL: https://<your-atlas-host>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Dashboard → Product catalog → Price ids (recurring monthly)
# List prices live in lib/billing/plans.ts — only Stripe Price ids belong here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_AGENCY=
# Optional annual Price ids (future — no schema change required)
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_PROFESSIONAL_ANNUAL=
# STRIPE_PRICE_AGENCY_ANNUAL=
# Analytics collect runs on this APP_URL host — deploy Atlas with
# migrations 20260801_analytics.sql + 20260802_analytics_collect_rpc.sql
# applied, then republish sites so the beacon is injected.

# ---------------------------------------------------------------------------
# Email notifications (Sprint 17.0B) — server-only
# Never put RESEND_API_KEY or the service role key in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
# - mock (default): records sends in-memory for local/dev/tests
# - resend: Resend.com transactional email API
EMAIL_PROVIDER=mock
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
# From address verified in Resend (e.g. Atlas <notifications@yourdomain.com>)
EMAIL_FROM_ADDRESS=
# Required for recording notification delivery after public form submit
# (bypasses RLS for claim/send/status updates only)
SUPABASE_SERVICE_ROLE_KEY=
